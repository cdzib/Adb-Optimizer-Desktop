{
  "name": "@adb-optimizer/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "ADB Optimizer para escritorio",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "pnpm --filter @adb-optimizer/mirror build && node scripts/dev.mjs",
    "build:main": "pnpm --filter @adb-optimizer/mirror build && tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "dist": "pnpm build && electron-builder",
    "test": "pnpm --filter @adb-optimizer/mirror build && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @adb-optimizer/mirror build && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@adb-optimizer/mirror": "workspace:*",
    "qrcode.react": "^4.2.0",
    "bonjour-service": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "electron": "^40.10.2",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
