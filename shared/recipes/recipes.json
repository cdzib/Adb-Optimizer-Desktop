  "recipes": [
    {
      "id": "animations-off",
      "category": "performance",
      "risk": "safe",
      "requiresRoot": false,
      "impact": "high",
      "appliesTo": {
        "minSdk": 21
      },
      "titleKey": "recipe.animations_off.title",
      "summaryKey": "recipe.animations_off.summary",
      "steps": [
        {
          "run": "settings put global window_animation_scale 0",
          "verify": {
            "run": "settings get global window_animation_scale",
            "equals": "0"
          },
          "undo": "settings put global window_animation_scale {{prev}}",
          "undoIfUnset": "settings delete global window_animation_scale",
          "timeoutMs": 5000
        },
        {
          "run": "settings put global transition_animation_scale 0",
          "verify": {
            "run": "settings get global transition_animation_scale",
            "equals": "0"
          },
          "undo": "settings put global transition_animation_scale {{prev}}",
          "undoIfUnset": "settings delete global transition_animation_scale",
          "timeoutMs": 5000
        },
        {
          "run": "settings put global animator_duration_scale 0",
          "verify": {
            "run": "settings get global animator_duration_scale",
            "equals": "0"
          },
          "undo": "settings put global animator_duration_scale {{prev}}",
          "undoIfUnset": "settings delete global animator_duration_scale",
          "timeoutMs": 5000
        }
      ]
    },
