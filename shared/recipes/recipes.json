    {
      "id": "wanboos-launcher",
      "category": "tv",
      "risk": "advanced",
      "requiresRoot": true,
      "impact": "high",
      "appliesTo": {
        "minSdk": 21
      },
      "titleKey": "recipe.wanboos_launcher.title",
      "summaryKey": "recipe.wanboos_launcher.summary",
      "steps": [
        {
          "type": "installSystemApk",
          "run": "installSystemApk {{apkPath}}",
          "apkPath": "{{apkPath}}",
          "targetPath": "/system/priv-app/WanboOSLauncher/WanboOSLauncher.apk",
          "mode": "0644",
          "owner": "0:0",
          "selinuxContext": "u:object_r:system_file:s0",
          "disablePackages": ["com.google.android.tvlauncher"],
          "verify": {
            "run": "cmd package resolve-activity --brief --user 0 -a android.intent.action.MAIN -c android.intent.category.HOME",
            "contains": "com.tv.launcher.custom"
          },
          "undo": "restoreSystemApk {{backupPath}}",
          "timeoutMs": 300000
        },
        {
          "run": "pm list packages com.tv.launcher.custom",
          "verify": {
            "run": "pm list packages com.tv.launcher.custom",
            "contains": "com.tv.launcher.custom"
          },
          "undo": null,
          "timeoutMs": 20000
        },
        {
          "run": "cmd package resolve-activity --brief --user 0 -a android.intent.action.MAIN -c android.intent.category.HOME",
          "verify": {
            "run": "cmd package resolve-activity --brief --user 0 -a android.intent.action.MAIN -c android.intent.category.HOME",
            "contains": "com.tv.launcher.custom"
          },
          "undo": null,
          "timeoutMs": 20000
        }
      ]
    }
