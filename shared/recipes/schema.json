{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adb-optimizer.dev/schema/catalog.json",
  "title": "ADB Optimizer catalog",
  "oneOf": [
    { "$ref": "#/$defs/recipeCatalog" },
    { "$ref": "#/$defs/actionCatalog" }
  ],
  "$defs": {
    "risk": { "enum": ["safe", "moderate", "advanced"] },
    "category": {
      "enum": ["performance", "storage", "battery", "tv", "privacy", "startup"]
    },
    "impact": { "enum": ["low", "medium", "high"] },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": { "type": "string", "minLength": 1 },
        "equals": { "type": "string" },
        "contains": { "type": "string" },
        "matches": { "type": "string" },
        "expectEmptyOrExitCode": { "type": "integer" }
      },
      "required": ["run"]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["shell", "installSystemApk"] },
        "run": { "type": "string", "minLength": 1 },
        "verify": { "$ref": "#/$defs/verify" },
        "undo": { "type": ["string", "null"] },
        "undoIfUnset": { "type": "string" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "optional": { "type": "boolean" },
        "apkPath": { "type": "string", "minLength": 1 },
        "targetPath": { "type": "string", "pattern": "^/system/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$" },
        "mode": { "type": "string", "pattern": "^[0-7]{3,4}$" },
        "owner": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "selinuxContext": { "type": "string", "minLength": 1 },
        "disablePackages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)+$" } }
      },
      "required": ["run", "verify", "timeoutMs"],
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "installSystemApk" } }, "required": ["type"] },
          "then": { "required": ["apkPath", "targetPath", "mode", "owner", "selinuxContext", "disablePackages"] }
        }
      ]
    },
    "appliesTo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minSdk": { "type": "integer", "minimum": 21 },
        "maxSdk": { "type": "integer", "minimum": 21 },
        "isTv": { "type": ["boolean", "null"] },
        "manufacturers": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "category": { "$ref": "#/$defs/category" },
        "risk": { "$ref": "#/$defs/risk" },
        "requiresRoot": { "type": "boolean" },
        "impact": { "$ref": "#/$defs/impact" },
        "appliesTo": { "$ref": "#/$defs/appliesTo" },
        "titleKey": { "type": "string" },
        "summaryKey": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/step" }
        }
      },
      "required": [
        "id",
        "category",
        "risk",
        "requiresRoot",
        "impact",
        "appliesTo",
        "titleKey",
        "summaryKey",
        "steps"
      ],
      "allOf": [
        {
          "if": { "properties": { "steps": { "contains": { "properties": { "type": { "const": "installSystemApk" } }, "required": ["type"] } } } },
          "then": { "properties": { "requiresRoot": { "const": true } } }
        }
      ]
    },
    "recipeCatalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "catalogVersion": { "type": "string" },
        "note": { "type": "string" },
        "recipes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/recipe" }
        }
      },
      "required": ["schemaVersion", "catalogVersion", "recipes"]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "titleKey": { "type": "string" },
        "paramKind": { "enum": ["package", "none"] },
        "risk": { "$ref": "#/$defs/risk" },
        "run": { "type": "string" },
        "verify": { "$ref": "#/$defs/verify" },
        "undo": { "type": ["string", "null"] },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "minSdk": { "type": "integer", "minimum": 21 },
        "blocklist": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "titleKey", "paramKind", "risk", "run", "verify", "timeoutMs"]
    },
    "actionCatalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "note": { "type": "string" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action" }
        }
      },
      "required": ["schemaVersion", "actions"]
    }
  }
}
